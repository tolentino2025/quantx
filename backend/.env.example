# ── Database ──────────────────────────────────────────────────────────────────
# Supabase (produção):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Local (desenvolvimento):
# DATABASE_URL=postgresql://takeoff:quantx_local@localhost:5432/takeoffdb

DATABASE_URL=postgresql://takeoff:quantx_local@localhost:5432/takeoffdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ML Service ────────────────────────────────────────────────────────────────
ML_BASE_URL=http://localhost:8000

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Pipeline ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/quantx-pages
MODEL_VERSION=yolov15-spci-2026.04
RENDER_DPI=150
