# ── Supabase ───────────────────────────────────────────────────────────────────
# Projeto na região sa-east-1 (São Paulo) para conformidade LGPD.
# Obtenha em: https://app.supabase.com → Settings → API

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>            # Frontend: chave pública (somente leitura)
SUPABASE_SERVICE_ROLE_KEY=<service-key> # Backend/worker: NUNCA exponha no frontend

# ── Database (Supabase Transaction Pooler — porta 6543) ─────────────────────
# Obtenha em: https://app.supabase.com → Settings → Database → Connection string
# Modo: Transaction (Supavisor) para BullMQ workers de curta duração.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ML Service ────────────────────────────────────────────────────────────────
ML_BASE_URL=http://localhost:8000

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Pipeline ─────────────────────────────────────────────────────────────────
MODEL_VERSION=yolov15-spci-2026.04
RENDER_DPI=150
# WORKER_TMP=/tmp/quantx-worker   # diretório temporário no RunPod (não persistido)

# ── Auth ─────────────────────────────────────────────────────────────────────
# AI_SERVICE_TOKEN=           # token interno para autenticação entre serviços
# ANTHROPIC_API_KEY=          # necessário se Claude Vision habilitado
