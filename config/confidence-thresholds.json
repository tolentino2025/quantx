{
  "_comment": "Thresholds de confiança por classe para o ConfidenceRouter. Editar somente com justificativa no commit message e via hook pre-threshold-change.sh.",
  "_version": "1.0",
  "_last_updated": "2026-05-09",

  "defaults": {
    "auto_accept": 0.85,
    "verify_with_vision": 0.65,
    "reject": 0.40,
    "calibrated": false
  },

  "budget": {
    "hard_cap_cents": 50.0,
    "alert_cents": 30.0,
    "estimated_vision_cost_cents": 2.5
  },

  "source_weights": {
    "yolo":     { "weight": 1.00 },
    "dinov2":   { "weight": 0.95 },
    "rtdetr":   { "weight": 1.05 },
    "vision":   { "weight": 1.00 },
    "template": { "weight": 0.70 }
  },

  "agreement_rules": {
    "yolo_dinov2_agree_boost":    0.10,
    "yolo_dinov2_disagree_cap":   0.65,
    "border_detection_penalty":   "downgrade_one_level",
    "uncalibrated_max_auto_accept": 0.90
  },

